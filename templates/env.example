# 复制为 .env 后修改，改完执行 docker compose up -d 生效。
# 注意：每行只写「名字=值」，不要在值后面加注释。


# ---------- 大模型（任选一家，兼容 OpenAI 接口即可） ----------
# 通义千问（阿里云百炼，北京地域）。Base URL 在百炼控制台 API Key 页面的上方可以复制。
LLM_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_VISION_MODEL=qwen3-vl-plus
LLM_TEXT_MODEL=qwen3-vl-plus

# 改用 DeepSeek 时，把上面四行换成：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-你的DeepSeekAPIKey
# LLM_VISION_MODEL=deepseek-flash
# LLM_TEXT_MODEL=deepseek-flash
#
# LLM_API_KEY 留空时是演示模式：只能读取 Excel / Word 表格，报告文字用模板生成。

# ---------- 账号与额度 ----------
# 改成 false 就关闭公开注册
ALLOW_REGISTER=true
# 注册邀请码，留空表示不需要。管理员也可以在网站「设置 → 管理员」里修改，以网站上改的为准
INVITE_CODE=change-me-2026
# 每个账号每月可生成的批次数
MONTHLY_QUOTA=50
# 单个上传文件的大小上限（MB）
MAX_FILE_MB=20
# 配好 HTTPS 之后改成 true；只用 http://IP:端口 测试时保持 false，否则登录不上
COOKIE_SECURE=false
# 同时处理的任务数，2 核 4G 的服务器保持 2
WORKERS=2
